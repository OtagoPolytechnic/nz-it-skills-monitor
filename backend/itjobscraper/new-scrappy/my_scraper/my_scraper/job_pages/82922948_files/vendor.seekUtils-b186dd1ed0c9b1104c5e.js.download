บงาน","Add licence or certification":"เพิ่มใบอนุญาตและเอกสารรับรอง","Add a summary of your career, achievements, and interests.":"เพิ่มสรุปเกี่ยวกับอาชีพ ความสำเร็จ และความสนใจของคุณ","Add summary":"เพิ่มสรุป","Add your availability so employers know how soon you can start.":"เพิ่มความพร้อมในการเริ่มงาน เพื่อให้นายจ้างทราบว่าคุณพร้อมเริ่มงานเมื่อไหร่","Add availability":"เพิ่มความพร้อมในการเริ่มงาน","Receive valuable insights about your industry.":"รับข้อมูลเชิงลึกเกี่ยวกับอุตสาหกรรมของคุณ","Add classification":"เพิ่มหมวดงาน","Full-time, part-time, contract – tell us what you’re looking for to get better recommendations.":"งานเต็มเวลา งานพาร์ทไทม์ งานสัญญาจ้าง บอกให้เราทราบว่าคุณกำลังมองหาอะไรเพื่อรับคำแนะนำที่ใช่กว่าเดิม","Add work preferences":"เพิ่มประเภทงานที่ต้องการ","Add languages to appeal to more companies and employers.":"เพิ่มภาษาเพื่อดึงดูดบริษัทและผู้ประกอบการมากขึ้น","Add language":"เพิ่มภาษา"}')},6275:(e,n,a)=>{"use strict";a.d(n,{PQ:()=>r});var l=a(81401),i=a(19668),t=a(79474),s="__googleOneTapScript__",o="Failed to load Google One Tap script",r=function(e){var n,a,r,d,u=e.autoLogin,p=void 0!==u&&u,c=e.cancelOnTapOutside,m=void 0===c||c,f=e.disableCancelOnUnmount,y=void 0!==f&&f,h=e.isAuthenticated,T=void 0!==h&&h,k=e.language,g=e.onCallback,N=e.onError,b=e.onLoadError,R=e.onSuccess,S=e.returnPath,L=void 0===S?"/":S,C=(n="https://accounts.google.com/gsi/client",r=(a=(0,t.useState)(n?"loading":"idle"))[0],d=a[1],(0,t.useEffect)(function(){if(!n){d("idle");return}var e=document.querySelector('script[src="'.concat(n,'"]'));if(e)d(e.getAttribute("data-status")||"idle");else{(e=document.createElement("script")).src=n,e.async=!0,e.setAttribute("data-status","loading"),document.body.appendChild(e);var a=function(n){e&&e.setAttribute("data-status","load"===n.type?"ready":"error")};e.addEventListener("load",a),e.addEventListener("error",a)}var l=function(e){d("load"===e.type?"ready":"error")};return e.addEventListener("load",l),e.addEventListener("error",l),fu