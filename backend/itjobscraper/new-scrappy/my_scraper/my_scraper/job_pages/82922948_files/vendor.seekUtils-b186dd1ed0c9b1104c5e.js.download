rds":"Informasi keuangan","Personal and health information":"Informasi pribadi dan kesehatan","Learn more by reading our article, Sensitive information: what you need to know.":"Pelajari lebih lanjut dengan membaca artikel kami, <TextLink>Informasi sensitif: apa yang perlu Anda ketahui</TextLink>.","Close":"Tutup"}')},7817:e=>{"use strict";e.exports=JSON.parse('{"Apply":"สมัคร","Quick apply":"สมัครงาน","Unsave":"เลิกการบันทึก","Save":"บันทึก","Apply for {jobTitle} at {jobCompanyName}":"สมัครตำแหน่ง{jobTitle}ที่{jobCompanyName}","Unsave {jobTitle} at {jobCompanyName}":"ยกเลิกการบันทึก{jobTitle}ที่{jobCompanyName}","Save {jobTitle} at {jobCompanyName}":"บันทึก{jobTitle}ที่{jobCompanyName}","For more information, contact us on {phoneNumber}.":"สำหรับข้อมูลเพิ่มเติม กรุณาติดต่อเราที่ <TextLink>{phoneNumber}</TextLink>","Company information":"ข้อมูลบริษัท","About the recruiter":"เกี่ยวกับเจ้าหน้าที่สรรหาบุคลากร","Employer questions":"คำถามจากผู้ประกอบการ","Your application will include the following questions:":"ใบสมัครของคุณจะประกอบด้วยคำถามต่อไปนี้:","Fraudulent":"การฉ้อโกง","Discrimination":"การเลือกปฏิบัติ","Misleading":"การหลอกลวง","We need an email address to get back to you.":"เราต้องการอีเมลเพื่อติดต่อกลับคุณ","We need a reason for reporting this job.":"เราต้องการเหตุผลในการรายงานเกี่ยวกับประกาศงานนี้","This field is required":"จำเป็นต้องระบุ","Report this job advert":"รายงานประกาศงานนี้","Be careful":"โปรดระวัง","Don’t provide your bank or credit card details when applying for jobs.":"ไม่ให้รายละเอียดธนาคารหรือบัตรเครดิตในการสมัครงาน","This job ad has not been subjected to our hirer verification process...":"ประกาศงานนี้ยังไม่ได้อยู่ภายใต้กระบวนการตรวจสอบผู้ประกอบการของเรา ขอให้ระมัดระวังและทำการตรวจสอบด้วยตนเองก่อนการให้ข้อมูลส่วนตัว","Learn how to protect yourself":"เรียนรู้วิธีปกป้องตนเอง","Report this job ad":"รายงานประกาศงานนี้","Thank you. Your job report has been forwarded to our job quality team.":"ขอบคุณ เราได้ส่งต่อรายงานของคุณเกี่ยวกับประกาศงานไปยังทีมงานตรวจสอบของเราแล้ว","It looks like something went wrong and your report could not be sent.":"ขออภัย มีเหตุผิดพลาด ไม่สามารถส่งรายงานของคุณ","Your email address":"อีเมลของคุณ","Reason for reporting job":"เหตุผลในการรายงานประกาศงานนี้","Please select":"กรุณาเลือก","Additional comments":"ความคิดเห็นเพิ่มเติม","Report job":"รายงานประกาศงานนี้","Cancel":"ยกเลิก","Check out this job on SEEK:":"ดูตำแหน่งงานนี้ใน JobsDB by SEEK:","You confirm that you’re at least 20 years old or have parental consent for JobsDB and affiliates to process your personal data. By submitting this information, you agree to our Privacy Policy.":"ท่านยืนยันว่าท่านมีอายุตั้งแต่ 20 ปีขึ้นไป หรือท่านได้รับความยินยอมจากผู้ปกครอง เพื่อยินยอมให้ JobsDB และบริษัทในเครือประมวลผลข้อมูลส่วนบุคคลของท่าน. คุณได้ยอมรับข้อตกลงและเงื่อนไข รวมถึง<TextLink>นโยบายความเป็นส่วนตัว</TextLink>ของเรา","To help fast track investigation, please include here any other relevant details that prompted you to report this job ad as fraudulent / misleading / discriminatory.":"เพื่อช่วยเร่งกระบวนการตรวจสอบ กรุณาระบุรายละเอียดที่เกี่ยวข้องอื่น ๆ ที่ทำให้คุณรายงานประกาศนี้ว่าเป็นการฉ้อโกง / ทำให้เข้าใจผิด / เลือกปฏิบัติ"}')},8067:(e,n,a)=>{"use strict";a.d(n,{Ao:()=>V,EK:()=>J,rY:()=>B});var l,i=a(89895),t=a(15130),s=a.n(t);function o(e){let n={};for(let a in e)n[a]=e[a];return n}function r(e){return function(n){let{input:a,output:l}=n;return s()(a,e)?{input:a.substr(e.length),output:l}:{error:`Expected ${e}, but got ${a.substr(0,e.length)}...`}}}function d(e){return function(n){let{input:a,output:l}=n,i=e.exec(a);return i&&0===i.index?{input:a.substr(i[0].length),output:l}:{error:`Expected ${String(e)}, but got ${a}`}}}function u(e){return function(n){let a=e(n);return"error"in a&&a.error?n:a}}function p(){for(var e=arguments.length,n=Array(e),a=0;a<e;a++)n[a]=arguments[a];return function(e){let a=e;for(let e of n){let n=e(a);if("error"in n&&n.error)return n;a=n}return a}}function c(e){let n=arguments.length>1&&void 0!==argument