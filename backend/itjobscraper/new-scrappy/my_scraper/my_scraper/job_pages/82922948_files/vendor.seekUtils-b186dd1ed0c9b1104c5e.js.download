    option {
      id
      description
    }
    newToWorkforce
  }
`;let nE=(0,nD.Ay)`
  fragment qualification on Qualification {
    id
    name {
      text
      ontologyId
    }
    institute {
      text
      ontologyId
    }
    completed
    completionDate {
      ... on Year {
        year
      }
      ... on MonthYear {
        month
        year
      }
    }
    formattedCompletion
    highlights
    status
    verificationUrl
    credential {
      credentialInfo {
        name
        values
      }
      manageVerificationUrl
      deleteVerificationUrl
    }
  }
`,nU=(0,nD.Ay)`
