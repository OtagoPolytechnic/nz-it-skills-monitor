 detail pribadi","Highlight your experience to employers.":"Tunjukkan pengalaman Anda kepada perekrut.","Add most recent role":"Tambah pengalaman kerja terbaru","Let employers find and approach you for new job opportunities.":"Beri kesempatan perekrut untuk menemukan dan mendekati kamu untuk peluang kerja baru.","Set profile visibility":"Atur visibilitas profil","You’re 50% more likely to be contacted by employers if you add a resumé.":"Kamu 50% lebih mungkin dihubungi oleh perekrut jika menambahkan resume.","Add a resumé":"Tambah resumé","Add a description so employers know what skills you could bring to their team.":"Tambahkan deskripsi sehingga perekrut tahu apa saja keterampilan yang bisa Anda berikan kepada tim.","Complete work history":"Riwayat kerja lengkap","Show employers you have the skills and experience they need.":"Tunjukkan kepada perekrut bahwa kamu memiliki keterampilan dan pengalaman yang dibutuhkan.","Add another role":"Tambah posisi lain","Show employers that you’re qualified and ready for their role.":"Tunjukkan kepada perekrut bahwa kamu memenuhi syarat dan siap memegang posisi.","Add education":"Tambah pendidikan","Appear in more searches by adding a minimum salary.":"Muncul di lebih banyak pencarian dengan menambahkan gaji minimum.","Add salary":"Tambah gaji","Let employers know where you have the right to work.":"Beri tahu di mana kamu memiliki izin untuk bekerja.","Add work rights":"Tambah izin kerja","Show employers you have the right skills for the role.":"Tunjukkan bahwa kamu memiliki keterampilan yang sesuai untuk posisi ini.","Add 5 or more skills":"Tambah 5 atau lebih keterampilan","Show employers you have the right credentials for the job.":"Tunjukkan kepada perekrut bahwa kamu memiliki kredensial yang tepat untuk posisi tersebut.","Add licence or certification":"Tambah lisensi atau sertifikat","Add a summary of your career, achievements, and interests.":"Tambahkan ringkasan karir, pencapaian, dan minat kamu.","Add summary":"Tambah ringkasan","Add your availability so employers know how soon you can start.":"Tambahkan informasi ketersediaan sehingga perekrut tahu kapan kamu dapat mulai bekerja.","Add availability":"Tambah ketersediaan","Receive valuable insights about your industry.":"Dapatkan wawasan bermanfaat tentang industri.","Add classification":"Tambah klasifikasi","Full-time, part-time, contract – tell us what you’re looking for to get better recommendations.":"Full-time, paruh waktu, kontrak – beri tahu kami jenis pekerjaan yang diinginkan untuk rekomendasi yang lebih baik.","Add work preferences":"Tambah preferensi kerja","Add languages to appeal to more companies and employers.":"Tambah bahasa agar menarik lebih banyak perusahaan dan perekrut.","Add language":"Tambah bahasa"}')},57652:e=>{"use strict";e.exports=JSON.parse('{"The file is too large. It must...":"File terlalu besar. File harus lebih kecil dari {maxFileSize} MB."}')},57659:e=>{"use strict";e.exports=JSON.parse('{"Filenames can\'t contain special characters...":"Nama file tidak boleh mengandung karakter spesial seperti \\" \\\\ / Coba ganti nama file Anda"}')},57973:e=>{"use strict";e.exports=JSON.parse('{"Both a month and year must be selected":"Bulan dan tahun harus dipilih"}')},58070:e=>{"use strict";e.exports=JSON.parse('{"Max characters or less":"{max} karakter atau kurang"}')},58127:e=>{"use strict";e.exports=JSON.parse('{"Show all":"[Šḩöööŵ ăăăƚƚ]","+{numOfQualitiesToHide} more":"[+{numOfQualitiesToHide} m̂ööřẽẽ]"}')},58246:e=>{"use strict";e.exports=JSON.parse('{"The file is too large. It must...":"[Ṯḩẽẽẽ ƒìììƚẽẽẽ ìììš ṯöööööö ƚăăăřģẽẽẽ. Ïṯ m̂ǚǚǚšṯ ßẽẽẽ šm̂ăăăƚƚẽẽẽř ṯḩăăăกี้ {maxFileSize}Ṃẞ.]"}')},58314:e=>{"use strict";e.exports=JSON.parse('{"Let’s make sure employers can get in touch with you.":"[Łẽẽẽṯ’š m̂ăăăķẽẽẽ šǚǚǚřẽẽẽ ẽẽẽm̂ƥƚöööýýýẽẽẽřš çăăăกี้ ģẽẽẽṯ ìììกี้ ṯöööǚǚǚçḩ ŵìììṯḩ ýýýöööǚǚǚ.]","Add personal details":"[Ậƌƌ ƥẽẽẽřšöööกี้ăăăƚ ƌẽẽẽṯăăăìììƚš]","Highlight your experience to employers.":"[Ḩìììģḩƚìììģḩṯ ýýýöööǚǚǚř ẽẽẽꭕƥẽẽẽřìììẽẽẽกี้çẽẽẽ ṯööö ẽẽẽm̂ƥƚöööýýýẽẽẽřš.]","Add most recent role":"[Ậƌƌ m̂öööšṯ řẽẽẽçẽẽẽกี้ṯ řöööƚẽẽẽ]","Let employers find and approach you for new job opportunities.":"[Łẽẽẽṯ ẽẽẽm̂ƥƚöööýýýẽẽẽřš ƒìììกี้ƌ ăăăกี้ƌ ăăăƥƥřöööăăăçḩ ýýýöööǚǚǚ ƒöööř กี้ẽẽẽŵ ĵöööß öööƥƥöööřṯǚǚǚกี้ìììṯìììẽẽẽš.]","Set profile visibility":"[Šẽẽṯ ƥřööƒììƚẽẽ ṽììšììßììƚììṯýý]","You’re 50% more likely to be contacted by employers if you add a resumé.":"[Ýöööǚǚǚ’řẽẽẽ 50% m̂öööřẽẽẽ ƚìììķẽẽẽƚýýý ṯööö ßẽẽẽ çöööกี้ṯăăăçṯẽẽẽƌ ßýýý ẽẽẽm̂ƥƚöööýýýẽẽẽřš ìììƒ ýýýöööǚǚǚ ăăăƌƌ ăăă řẽẽẽšǚǚǚm̂é.]","Add a resumé":"[Ậƌƌ ăăă řẽẽẽšǚǚǚm̂é]","Add a description so employers know what skills you could bring to their team.":"[Ậƌƌ ăăă ƌẽẽẽšçřìììƥṯìììöööกี้ šööö ẽẽẽm̂ƥƚöööýýýẽẽẽřš ķกี้öööŵ ŵḩăăăṯ šķìììƚƚš ýýýöööǚǚǚ çöööǚǚǚƚƌ ßřìììกี้ģ ṯööö ṯḩẽẽẽìììř ṯẽẽẽăăăm̂.]","Complete work history":"[Çöööm̂ƥƚẽẽẽṯẽẽẽ ŵöööřķ ḩìììšṯöööřýýý]","Show employers you have the skills and experience they need.":"[Šḩöööŵ ẽẽẽm̂ƥƚöööýýýẽẽẽřš ýýýöööǚǚǚ ḩăăăṽẽẽẽ ṯḩẽẽẽ šķìììƚƚš ăăăกี้ƌ ẽẽẽꭕƥẽẽẽřìììẽẽẽกี้çẽẽẽ ṯḩẽẽẽýýý กี้ẽẽẽẽẽẽƌ.]","Add another role":"[Ậƌƌ ăăăกี้öööṯḩẽẽẽř řöööƚẽẽẽ]","Show employers that you’re qualified and ready for their role.":"[Šḩöööŵ ẽẽẽm̂ƥƚöööýýýẽẽẽřš ṯḩăăăṯ ýýýöööǚǚǚ’řẽẽẽ q̇ǚǚǚăăăƚìììƒìììẽẽẽƌ ăăăกี้ƌ řẽẽẽăăăƌýýý ƒöööř ṯḩẽẽẽìììř řöööƚẽẽẽ.]","Add education":"[Ậƌƌ ẽẽẽƌǚǚǚçăăăṯìììöööกี้]","Appear in more searches by adding a minimum salary.":"[Ậƥƥẽẽẽăăăř ìììกี้ m̂öööřẽẽẽ šẽẽẽăăăřçḩẽẽẽš ßýýý ăăăƌƌìììกี้ģ ăăă m̂ìììกี้ìììm̂ǚǚǚm̂ šăăăƚăăăřýýý.]","Add salary":"[Ậƌƌ šăăăƚăăăřýýý]","Let employers know where you have the right to work.":"[Łẽẽẽṯ ẽẽẽm̂ƥƚöööýýýẽẽẽřš ķกี้öööŵ ŵḩẽẽẽřẽẽẽ ýýýöööǚǚǚ ḩăăăṽẽẽẽ ṯḩẽẽẽ řìììģḩṯ ṯööö ŵöööřķ.]","Add work rights":"[Ậƌƌ ŵööööřķ řììììģḩṯš]","Show employers you have the right skills for the role.":"[Šḩöööŵ ẽẽẽm̂ƥƚöööýýýẽẽẽřš ýýýöööǚǚǚ ḩăăăṽẽẽẽ ṯḩẽẽẽ řìììģḩṯ šķìììƚƚš ƒöööř ṯḩẽẽẽ řöööƚẽẽẽ.]","Add 5 or more skills":"[Ậƌƌ 5 öööř m̂öööřẽẽẽ šķìììƚƚš]","Show employers you have the right credentials for the job.":"[Šḩöööŵ ẽẽẽm̂ƥƚöööýýýẽẽẽřš ýýýöööǚǚǚ ḩăăăṽẽẽẽ ṯḩẽẽẽ řìììģḩṯ çřẽẽẽƌẽẽẽกี้ṯìììăăăƚš ƒöööř ṯḩẽẽẽ ĵöööß.]","Add licence or certification":"[Ậƌƌ ƚìììçẽẽẽกี้çẽẽẽ öööř çẽẽẽřṯìììƒìììçăăăṯẽẽẽ]","Add a summary of your career, achievements, and interests.":"[Ậƌƌ ăăă šǚǚǚm̂m̂ăăăřýýý öööƒ ýýýöööǚǚǚř çăăăřẽẽẽẽẽẽř, ăăăçḩìììẽẽẽṽẽẽẽm̂ẽẽẽกี้ṯš, ăăăกี้ƌ ìììกี้ṯẽẽẽřẽẽẽšṯš.]","Add summary":"[Ậƌƌ šǚǚǚm̂m̂ăăăřýýý]","Add your availability so employers know how soon you can start.":"[Ậƌƌ ýýýöööǚǚǚř ăăăṽăăăìììƚăăăßìììƚìììṯýýý šööö ẽẽẽm̂ƥƚöööýýýẽẽẽřš ķกี้öööŵ ḩöööŵ šööööööกี้ ýýýöööǚǚǚ çăăăกี้ šṯăăăřṯ.]","Add availability":"[Ậƌƌ ăăṽăăììƚăăßììƚììṯýý]","Receive valuable insights about your industry.":"[Řẽẽçẽẽììṽẽẽ ṽăăƚǚǚăăßƚẽẽ ììกี้šììģḩṯš ăăßööǚǚṯ ýýööǚǚř ììกี้ƌǚǚšṯřýý.]","Add classification":"[Ậƌƌ çƚăăăššìììƒìììçăăăṯìììöööกี้]","Full-time, part-time, contract – tell us what you’re looking for to get better recommendations.":"[Ƒǚǚǚƚƚ-ṯìììm̂ẽẽẽ, ƥăăăřṯ-ṯìììm̂ẽẽẽ, çöööกี้ṯřăăăçṯ – ṯẽẽẽƚƚ ǚǚǚš ŵḩăăăṯ ýýýöööǚǚǚ’řẽẽẽ ƚööööööķìììกี้ģ ƒöööř ṯööö ģẽẽẽṯ ßẽẽẽṯṯẽẽẽř řẽẽẽçöööm̂m̂ẽẽẽกี้ƌăăăṯìììöööกี้š.]","Add work preferences":"[Ậƌƌ ŵöööřķ ƥřẽẽẽƒẽẽẽřẽẽẽกี้çẽẽẽš]","Add languages to appeal to more companies and employers.":"[Ậƌƌ ƚăăăกี้ģǚǚǚăăăģẽẽẽš ṯööö ăăăƥƥẽẽẽăăăƚ ṯööö m̂öööřẽẽẽ çöööm̂ƥăăăกี้ìììẽẽẽš ăăăกี้ƌ ẽẽẽm̂ƥƚöööýýýẽẽẽřš.]","Add language":"[Ậƌƌ ƚăăăกี้ģǚǚǚăăăģẽẽẽ]"}')},58389:e=>{"use strict";e.exports=JSON.parse('{"Inappropriate word":"Kata tidak pantas"}')},58595:(e,n,a)=>{"use strict";a.d(n,{A:()=>t});var l=a(79474);let i={},t=e=>(i[e]||(i[e]=l.createContext(null)),i[e])},58995:e=>{"use strict";e.exports=JSON.parse('{"Add {quality}":"เพิ่ม {quality}","Remove {quality}":"ลบ {quality}","Added to profile":"เพิ่มทักษะในโปรไฟล์ของคุณ","Removed from profile":"ทักษะถูกลบออกจากโปรไฟล์ของคุณ","There was a problem adding this item. Try refreshing or try again later.":"เกิดปัญหาในการเพิ่มรายการนี้ ลองรีเฟรชหรือลองใหม่อีกครั้งภายหลัง"}')},59049:e=>{"use strict";e.exports=JSON.parse('{"Protect your privacy":"[Ƥřööṯẽẽçṯ ýýööǚǚř ƥřììṽăăçýý]","We detected potentially sensitive information in your files...":"[Ŵẽẽẽ ƌẽẽẽṯẽẽẽçṯẽẽẽƌ ƥöööṯẽẽẽกี้ṯìììăăăƚƚýýý šẽẽẽกี้šìììṯìììṽẽẽẽ ìììกี้ƒöööřm̂ăăăṯìììöööกี้ ìììกี้ ýýýöööǚǚǚř ƒìììƚẽẽẽš. Ŵẽẽẽ řẽẽẽçöööm̂m̂ẽẽẽกี้ƌ řẽẽẽm̂öööṽìììกี้ģ ìììṯ ṯööö ƥřöööṯẽẽẽçṯ ýýýöööǚǚǚř šăăăƒẽẽẽṯýýý.]","Sensitive information includes:":"[Šẽẽẽกี้šìììṯìììṽẽẽẽ ìììกี้ƒöööřm̂ăăăṯìììöööกี้ ìììกี้çƚǚǚǚƌẽẽẽš:]","Identity documents":"[Ïƌẽẽẽกี้ṯìììṯýýý ƌöööçǚǚǚm̂ẽẽẽกี้ṯš]","Financial and official records":"[Ƒìììกี้ăăăกี้çìììăăăƚ ăăăกี้ƌ öööƒƒìììçìììăăăƚ řẽẽẽçöööřƌš]","Personal and health information":"[Ƥẽẽẽřšöööกี้ăăăƚ ăăăกี้ƌ ḩẽẽẽăăăƚṯḩ ìììกี้ƒöööřm̂ăăăṯìììöööกี้]","Learn more by reading our article, Sensitive information: what you need to know.":"[Łẽẽẽăăăřกี้ m̂öööřẽẽẽ ßýýý řẽẽẽăăăƌìììกี้ģ öööǚǚǚř ăăăřṯìììçƚẽẽẽ, <TextLink>Šẽẽẽกี้šìììṯìììṽẽẽẽ ìììกี้ƒöööřm̂ăăăṯìììöööกี้: ŵḩăăăṯ ýýýöööǚǚǚ กี้ẽẽẽẽẽẽƌ ṯööö ķกี้öööŵ</TextLink>.]","Close":"[Çƚööšẽẽ]"}')},59107:e=>{"use strict";e.exports=JSON.parse('{"{jobTitle}":"{jobTitle}","I found you a job on SEEK!":"I found you a job on Jobstreet by SEEK!","Hey,":"Hey,","I found this job via SEEK and thought of you.":"I found this job via SEEK and thought of you.","Share":"Share","Email":"Email","Facebook":"Facebook","Twitter":"Twitter","LinkedIn":"LinkedIn","Report job ad":"Report job ad","Share or report ad":"Share or report ad","Opens in a new tab":"Opens in a new tab"}')},59141:e=>{"use strict";e.exports=JSON.parse('{"Stay safe. Don’t include sensitive information in your documents.":"อย่าใส่ข้อมูลที่ละเอียดอ่อนในเอกสารของคุณ","More about privacy and data use":"ข้อมูลเพิ่มเติมเกี่ยวกับความเป็นส่วนตัวและการใช้ข้อมูล","Protect your privacy":"ปกป้องความเป็นส่วนตัวของคุณ","Only share necessary information...":"ให้เฉพาะข้อมูลที่จำเป็น อย่าใส่เนื้อหา เช่น เอกสารประจำตัว (เช่น หนังสือเดินทาง ใบขับขี่) ข้อมูลการเงิน (เช่น เลขประจำตัวผู้เสียภาษีอากร) เชื้อชาติ ศาสนา หรือข้อมูลสุขภาพ","How brand uses your data":"{brand, select, seek {SEEK} jobsdb {Jobsdb} jobstreet {Jobstreet} other {SEEK}} นำข้อมูลของคุณมาใช้อย่างไรบ้าง","Using data based on employers\' past behaviour...":"จากการใช้ข้อมูลที่อิงจากพฤติกรรมของผู้ประกอบการที่ผ่านมา เรซูเม่หลักของท่าน และปัจจัยอื่น ๆ {brand, select, seek {SEEK} jobsdb {Jobsdb} jobstreet {Jobstreet} other {SEEK}} จะคาดการณ์ว่าเมื่อใดที่ท่านมีแนวโน้มว่าอาจเป็นผู้หางานที่น่าสนใจสำหรับตำแหน่งงาน และอาจแสดงข้อมูลนี้ให้กับท่านและผู้ประกอบการทราบ","If you do not have a default resume,...":"หากท่านไม่มีเรซูเม่หลัก เรซูเม่ที่ท่านใช้ในการสมัครงานจะถูกนำมาเป็นเรซูเม่หลัก หากท่านตั้งค่าระดับการเปิดเผยโปรไฟล์เป็นอนุญาตให้ดูข้อมูล ผู้ประกอบการที่ค้นหาผู้หางานสามารถดูโปรไฟล์ {brand, select, seek {SEEK} jobsdb {Jobsdb} jobstreet {Jobstreet} other {SEEK}} และเรซูเม่หลักของท่าน","In an application, we remove external links from documents to adhere to our security standards.":"สำหรับการสมัครงาน เราจะทำการนำลิงก์ที่ไม่เกี่ยวข้องออกจากเอกสารเพื่อให้เป็นไปตามมาตรฐานความปลอดภัยของเรา","If you delete a file from your profile after sending...":"หากท่านลบไฟล์ออกจากโปรไฟล์หลังจากการส่งใบสมัครงานแล้ว ผู้ประกอบการจะยังคงเห็นไฟล์ดังกล่าวบนแพลตฟอร์มของ {brand, select, seek {SEEK} jobsdb {Jobsdb} jobstreet {Jobstreet} other {SEEK}} เป็นระยะเวลาหนึ่ง","By uploading documents, you agree to our Collection Notice and Privacy Statement.":"ท่านได้ยอมรับคำประกาศเกี่ยวกับการเก็บรวบรวมข้อมูลส่วนบุคคล และนโยบายความเป็นส่วนตัวเพื่ออัปโหลดข้อมูล","By uploading documents, you agree to our Collection Notice and Privacy Statement. [with links]":"ท่านได้ยอมรับ<CollectionNoticeLink>คำประกาศเกี่ยวกับการเก็บรวบรวมข้อมูลส่วนบุคคล</CollectionNoticeLink> และ<PrivacyStatementLink>นโยบายความเป็นส่วนตัว</PrivacyStatementLink>เพื่ออัปโหลดข้อมูล","Privacy Statement":"นโยบายความเป็นส่วนตัว","Collection Notice":"คำประกาศเกี่ยวกับการเก็บรวบรวมข้อมูลส่วนบุคคล"}')},59274:e=>{"use strict";e.exports=JSON.parse('{"Was this skills match accurate?":"Was this skills match accurate?","Thank you for helping us improve the matching results.":"Thank you for helping us improve the matching results.","Yes":"Yes","No":"No"}')},59300:e=>{"use strict";e.exports=JSON.parse('{"Summary":"Ringkasan","Career history":"Riwayat karier","Skills":"Keahlian","Languages":"Bahasa","Education":"Pendidikan","Licences & certifications":"Lisensi & sertifikasi"}')},59481:(e,n,a)=>{"use strict";a.d(n,{nD:()=>S,gR:()=>R,I:()=>c,ID:()=>k,dh:()=>b,Lc:()=>y,iE:()=>g});var l=a(13274),i=a(18785),t=a(15393),s=a(58748),o=a(93751),r=a(55355),d=a(79474);a(37926),a(18074);let u=(0,d.createContext)({position:"header"}),p=()=>(0,d.useContext)(u),c=e=>{let{position:n,children:a}=e;return(0,l.jsx)(u.Provider,{value:{position:n},children:a})},m="linkContextHeaderFooter",f=`data-${m}`,y=(e,n)=>{let{key:a,opening:l,closing:i}=n;return{[a]:"opening"===e?l:i}},h=e=>{let{linkContext:n}=e},T=(0,d.createContext)({sendLinkEvent:h}),k=T.Provider,g=()=>{let{sendLinkEvent:e}=(0,d.useContext)(T),{position:n}=p(),a=e!==h;return{sendLinkEvent:a=>{let{linkContext:l}=a;return e({linkContext:{...l,position:n}})},injectLinkContextToData:(e,l)=>{let i={...e,position:n};return a?{...l,[m]:i}:l}}},N=e=>"object"==typeof e,b=(e,n)=>{let{[f]:a,...l}=e;return N(a)?[l,(null==n?void 0:n(a))||a]:[e]},R=e=>{let{icon:n,label:a,size:r="standard",tone:d="neutral",upDirectionCondition:u}=e;return(0,l.jsx)(i.E,{size:r,tone:d,children:(0,l.jsxs)(t.e,{space:"xxsmall",alignY:"center",children:[n?(0,l.jsx)(s.V,{children:(0,l.jsx)(n,{alignY:"lowercase"})}):null,a?(0,l.jsx)(s.V,{width:"content",children:a}):null,(0,l.jsx)(s.V,{children:(0,l.jsx)(o.V,{alignY:"lowercase",direction:u?"up":"down"})})]})})},S=e=>{let{callToAction:n,children:a,isInline:i=!1,isDirectionUpward:t=!1,isCallToActionFullWidth:s=!1,onExpendCollapseLinkContextData:o,onOpen:u=()=>null,actionDisplayText:p,actionTone:c="neutral",isStickyAction:m=!1}=e,{sendLinkEvent:f}=g(),[y,h]=(0,d.useState)(!1),T=()=>{h(!y)};(0,d.useEffect)(()=>{y&&u()},[y,u]);let k=(0,l.jsxs)(r.l,{onClick:()=>{T(),f({linkContext:{openin