  .EA097D-a * {
    margin: 0;
    padding: 0;
    border: 0;
    font: inherit;
    vertical-align: baseline;
    -webkit-font-smoothing: antialiased;
  }

  .EA097D-a *,
  .EA097D-a li:before {
    font-family: inherit;
    box-sizing: inherit;
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    -webkit-tap-highlight-color: transparent;
  }

  .EA097D-a {
    font-family: 'Roboto', 'Helvetica Neue', HelveticaNeue, Helvetica, Arial, sans-serif;
    font-size: 10px;
    box-sizing: border-box;
    min-height: 100%;
    position: relative;
  }

  .EA097D-b {
    font-size: 2.1em;
    line-height: 1.28571429em;
    -webkit-transform: translateY(0.26285714em);
    transform: translateY(0.26285714em);
    color: #1c1c1c;
    text-decoration: none;
    display: block;
    margin-bottom: 18px;
  }

  .EA097D-d {
    margin-bottom: 7px;
    list-style: none;
  }

  .EA097D-d li {
    font-size: 1.6em;
    line-height: 1.28571429em;
    -webkit-transform: translateY(0.26285714em);
    transform: translateY(0.26285714em);
  }

  .EA097D-d li {
    color: #1c1c1c;
    margin-bottom: 9px;
    margin-left: 17px;
    list-style: disc;
  }

  .EA097D-d li:last-child {
    margin-bottom: 30px;
  }

  .EA097D-f {
    font-size: 1.8em;
    line-height: 45px;
    border-radius: 2px;
    background: #fff;
    width: 160px;
    color: #2765cf;
    text-decoration: none;
    padding: 0 14px;
    border: 2px solid #2765cf;
    display: block;
    text-align: center;
  }

  .EA097D-h {
    height: 30px;
    width: 170px;
    margin-bottom: 0;
    background: url(https://cdn.seeklearning.com.au/media/images/career-guide/career-advice-blue.svg) no-repeat center;
    background-size: contain;
  }

  @media only screen and (min-width: 580px) {
    .EA097D-h {
      margin-bottom: 16px;
    }
  }
</style>

<div class="EA097D-a">
  <div class="EA097D-h"></div>
  <h1>
    <a class="EA097D-b" href="https://www.seek.com.au/career-advice/role/customer-consultant?campaigncode=lrn:skj:sklm:cg:jbd:alpha"
      >Thinking about a career as a Customer Consultant?</a
    >
  </h1>
  <ul class="EA097D-d">
    <li>Insights on salary & in-demand skills</li>
    <li>Reviews from people working in the industry</li>
  </ul>
  <a class="EA097D-f" href="https://www.seek.com.au/career-advice/role/customer-consultant?campaigncode=lrn:skj:sklm:cg:jbd:alpha">Explore career</a>
</div>
