  query GetSalaryNudge($zone: String!) {
    viewer {
      salaryNudge(zone: $zone) {
        callToActions {
          displayText
          operation
        }
        firstName
        id
        imageUrl
        prompt
        text
      }
    }
  }
`;(0,eg.Ay)`
  mutation AddSalaryNudgeFeedback(
    $nudgeId: ID!
    $nudgeOption: String!
    $zone: String!
  ) {
    addSalaryNudgeFeedback(
      nudgeId: $nudgeId
      nudgeOption: $nudgeOption
      zone: $zone
    ) {
      nudgeId
    }
  }
